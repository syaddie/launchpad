# Copy to .env and fill in. See docs/setup.md for where each value comes from.

# The address you open Launchpad at (no trailing slash). Used for the Google sign-in redirect.
PUBLIC_URL=https://launchpad.syaddy.com

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker install command, the part after --token)
TUNNEL_TOKEN=

# Google Cloud OAuth client (Calendar, Tasks, Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Cloudflare Access. When both are set, every request must carry a valid
# Access token, so the app can't be reached by bypassing Cloudflare.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: 17TRACK API key for live status on carriers other than SingPost.
SEVENTEEN_TRACK_API_KEY=

# Optional: Anthropic API key (https://platform.claude.com/) for the News and Inbox summaries and the Training note.
# Without it, News shows plain headlines for your topics and Inbox a plain list of emails.
ANTHROPIC_API_KEY=
# Optional: the Claude model that writes them. Defaults to claude-haiku-5-5, which
# costs cents a month here; claude-opus-5-5 writes richer summaries at ~40x the price.
NEWS_MODEL=
# Optional: the Claude model that writes the Inbox digests. Defaults to claude-haiku-5-5 too.
INBOX_MODEL=
# Optional: the Claude model that reads what each exercise trains and writes the Training note. Defaults to claude-haiku-5-5 too.
TRAINING_MODEL=
# Optional: the Claude model that writes the note on the week ahead in Learn. Defaults to claude-haiku-5-5 too.
LEARN_MODEL=

# Optional, for the Server view (docker-compose.yml sets both; see docs/setup.md step 8):
# where the host's /proc is mounted, so network traffic is the whole machine's...
# HOST_PROC=/host/proc
# ...and the Docker API for the container list (a socket proxy, or unix:///var/run/docker.sock).
# DOCKER_HOST=tcp://docker-proxy:2375

# Optional: data.gov.sg API key (https://data.gov.sg) for the weather beside the clock.
# Weather works without one; a key only raises the rate limit.
DATA_GOV_SG_API_KEY=
