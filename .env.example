# Copy to .env and fill in. See docs/setup.md for where each value comes from.

# The address you open Launchpad at (no trailing slash). Used for the Google sign-in redirect.
PUBLIC_URL=https://launchpad.syaddy.com

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → Docker install command, the part after --token)
TUNNEL_TOKEN=

# Google Cloud OAuth client (Calendar, Tasks, Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Cloudflare Access. When both are set, every request must carry a valid
# Access token, so the app can't be reached by bypassing Cloudflare.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Optional: 17TRACK API key for live status on carriers other than SingPost.
SEVENTEEN_TRACK_API_KEY=

# Optional: Anthropic API key (https://platform.claude.com/) for the daily digest, the Inbox summaries, the Training
# and Learn notes, and ⌘K's Ask Launchpad. Without it there's no digest, Inbox is a plain list of
# emails, and there's no Ask Launchpad. Server › Claude usage shows what each costs.
ANTHROPIC_API_KEY=
# Optional: the Claude model that writes the daily digest's lessons. Defaults to claude-opus-5-5
# (one call a day, about $2-3 a month for four subjects); claude-haiku-5-5 costs a few cents.
DIGEST_MODEL=
# Optional: the Claude model that writes the Inbox digests. Defaults to claude-haiku-5-5 too.
INBOX_MODEL=
# Optional: the Claude model that reads what each exercise trains and writes the Training note. Defaults to claude-haiku-5-5 too.
TRAINING_MODEL=
# Optional: the Claude model that writes the note on the week ahead in Learn. Defaults to claude-haiku-5-5 too.
LEARN_MODEL=
# Optional: the Claude model that turns what's typed in ⌘K into an action (Ask Launchpad). Defaults to claude-haiku-5-5 too.
ASK_MODEL=
# Optional: the Claude model that writes the weekly recap in Review. Defaults to claude-haiku-5-5 too.
REVIEW_MODEL=
# Optional: the Claude model behind Explain this log, in the Minecraft tab and the containers' logs. Defaults to claude-haiku-5-5 too.
EXPLAIN_MODEL=

# Optional, for the Server view (docker-compose.yml sets both; see docs/setup.md step 8):
# where the host's /proc is mounted, so network traffic is the whole machine's...
# HOST_PROC=/host/proc
# ...and the Docker API for the container list (a socket proxy, or unix:///var/run/docker.sock).
# DOCKER_HOST=tcp://docker-proxy:2375

# Optional: the Server view's terminal and file explorer. Launchpad signs in to the
# server over SSH as this user, with its own key (shown in the view; add it to that
# user's ~/.ssh/authorized_keys). docker-compose.yml points SSH_HOST at the host.
# Empty keeps them off. Turn on Cloudflare Access above before using them. See docs/setup.md step 9.
SSH_USER=
# SSH_PORT=22

# Optional: torrents in Server › Downloads, through the qbittorrent service in docker-compose.yml.
# The folder they download into on the server (make it first, as your user), and who owns
# what's written there (`id` shows yours). See docs/setup.md step 11.
TORRENTS_DIR=
# TORRENTS_UID=1000
# TORRENTS_GID=1000
# The Web UI login you set in qBittorrent (http://<server-lan-ip>:8091). Leave both empty if
# you let Launchpad's network in without a password instead.
QBIT_USER=
QBIT_PASS=

# Instagram posts in Server › Downloads use instaloader, which comes with the Docker image
# (nothing to set). Running Launchpad outside Docker: pip install instaloader, and point this
# at that Python. See docs/setup.md step 11.
# INSTALOADER_PYTHON=python3

# Optional: Music › Busking slots marks your own NAC bookings as yours with this: your busker
# profile ID, the id at the end of your public profile's address (eservices.nac.gov.sg/Busking/busker/profile/<id>),
# the same one schedule-sync uses. The whole address works too. Empty: your bookings show as taken. See docs/setup.md step 13.
NAC_BUSKER_ID=

# Optional: data.gov.sg API key (https://data.gov.sg) for the weather beside the clock.
# Weather works without one; a key only raises the rate limit.
DATA_GOV_SG_API_KEY=
